# Public site address used by Caddy, for example portfolio.example.com.
PORTFOLIO_SITE_ADDRESS=portfolio.example.com

# Host path containing the already-materialized, read-only FOSSIL public pack.
# Create it with scripts/g7_public_pack.py materialize or restore it from a verified bundle.
PORTFOLIO_PACK_ROOT_HOST=/srv/handsfree/portfolio-public

# Derived in-memory response cache only; safe to lose.
PORTFOLIO_CACHE_MAX_ENTRIES=256

# S3/R2 credentials are intentionally NOT part of this compose environment.
# Operator-only publish/restore commands use the standard boto3 credential chain
# and may set endpoint/bucket arguments outside the public API process.
