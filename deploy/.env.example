# Public site address used by Caddy, for example portfolio.example.com.
PORTFOLIO_SITE_ADDRESS=portfolio.example.com

# Host path containing an already-materialized, read-only FOSSIL public pack.
# G7 recovery work will make creation/restoration of this directory executable.
PORTFOLIO_PACK_ROOT_HOST=/srv/handsfree/portfolio-public

# Derived in-memory response cache only; safe to lose.
PORTFOLIO_CACHE_MAX_ENTRIES=256
