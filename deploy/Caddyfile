{$PORTFOLIO_SITE_ADDRESS} {
    @api path /health /v1/*

    handle @api {
        reverse_proxy api:8000 {
            flush_interval -1
        }
    }

    handle {
        root * /srv
        try_files {path} /index.html
        file_server
    }

    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        Permissions-Policy "camera=(), geolocation=()"
    }
}
