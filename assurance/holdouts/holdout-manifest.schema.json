{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://design-bakery.com/contracts/g6-holdout-manifest-v1.schema.json",
  "title": "G6 sealed holdout manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "bundleId",
    "createdAt",
    "owner",
    "items"
  ],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "bundleId": {"type": "string", "minLength": 8},
    "createdAt": {"type": "string", "format": "date-time"},
    "owner": {"type": "string", "minLength": 1},
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "class", "sha256", "scoringAuthority"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "class": {"enum": ["retrieval", "conversation", "naturalness"]},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "scoringAuthority": {"enum": ["deterministic", "corpus_derived_deterministic"]}
        }
      }
    }
  }
}
